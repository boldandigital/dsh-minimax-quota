{
  "name": "dsh-minimax-quota",
  "description": "MiniMax Token Plan quota chip for the DeepSeek Harness web surface: a compact inline entry in the composer dock showing the remaining 5-hour and weekly quota windows, with the full detail in a click-to-open panel.",
  "version": "0.2.1",
  "license": "MIT",
  "author": {
    "name": "boldandigital",
    "url": "https://github.com/boldandigital"
  },
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boldandigital/dsh-minimax-quota.git"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon": "./assets/icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets/icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "MARKETPLACES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-cordis-client-runner"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "minimax",
    "quota",
    "quota-chip"
  ],
  "engines": {
    "node": ">=22.0.0",
    "dsh": ">=0.2.0"
  },
  "homepage": "https://github.com/boldandigital/dsh-minimax-quota#readme",
  "bugs": {
    "url": "https://github.com/boldandigital/dsh-minimax-quota/issues"
  }
}
